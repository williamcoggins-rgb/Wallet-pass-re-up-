# ─── Vercel Environment Variables ────────────────────────────
# Set these in Vercel Dashboard > Settings > Environment Variables

# URLs where your Apple/Google backend services are running
APPLE_SERVICE_URL=https://your-apple-service.com
GOOGLE_SERVICE_URL=https://your-google-service.com

# Admin API key (must match the key set on both backend services)
ADMIN_API_KEY=your-secret-admin-key-here
