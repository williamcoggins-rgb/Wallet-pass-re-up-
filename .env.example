# ─── Vercel Environment Variables ────────────────────────────
# Set these in Vercel Dashboard > Settings > Environment Variables

# URLs where your Apple/Google backend services are running
APPLE_SERVICE_URL=https://your-apple-service.com
GOOGLE_SERVICE_URL=https://your-google-service.com

# Admin API key (must match the key set on both backend services)
ADMIN_API_KEY=your-secret-admin-key-here

# ─── Apple Pass Service ─────────────────────────────────────
# Pass Type ID registered in your Apple Developer portal
PASS_TYPE_IDENTIFIER=pass.com.reup.barbershop

# Your Apple Developer Team ID
TEAM_IDENTIFIER=YOUR_TEAM_ID

# Organization / business name shown on the pass
ORGANIZATION_NAME=ReUp Barbershop

# Short description of the pass
PASS_DESCRIPTION=ReUp Barbershop Loyalty Pass

# Paths to Apple signing certificates (keep these in secrets/ — gitignored)
PASS_CERT=./secrets/pass-cert.pem
PASS_KEY=./secrets/pass-key.pem
WWDR_CERT=./secrets/wwdr.pem

# HTTPS URL where the Apple pass web service is reachable
WEB_SERVICE_URL=https://your-apple-service.com/passes

# Apple Push Notification service (APNs) key for pass update pushes
APNS_KEY_PATH=./secrets/apns-key.p8
APNS_KEY_ID=YOUR_APNS_KEY_ID

# Apple service port
# PORT=8080

# ─── Google Wallet Service ──────────────────────────────────
# Google Wallet API Issuer ID (from Google Pay & Wallet Console)
GW_ISSUER_ID=YOUR_ISSUER_ID

# Service account credentials JSON (from Google Cloud Console)
GW_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Google service port
# PORT=8081
