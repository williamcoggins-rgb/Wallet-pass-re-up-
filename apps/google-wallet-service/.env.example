# ─── Google Wallet Service Configuration ─────────────────────

# Your Google Wallet Issuer ID (from Google Pay & Wallet Console)
GW_ISSUER_ID=YOUR_ISSUER_ID

# Service account credentials JSON (paste the full JSON or base64-encode it)
GW_CREDENTIALS_JSON={"client_email":"...","private_key":"..."}

# Admin API key (protects /admin endpoints — set the same key in Vercel env vars)
ADMIN_API_KEY=your-secret-admin-key-here

# Server port
PORT=8081
