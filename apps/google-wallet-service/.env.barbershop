# ─── Emporium Grooming & Supply — Google Wallet Configuration ─
# Copy this to .env and fill in your values.

# Your Google Wallet Issuer ID (from Google Pay & Wallet Console)
GW_ISSUER_ID=YOUR_ISSUER_ID

# Service account credentials JSON
GW_CREDENTIALS_JSON={"client_email":"...","private_key":"..."}

# Organization / branding
ORGANIZATION_NAME=Emporium Grooming & Supply
GW_DEFAULT_TITLE=Emporium Grooming & Supply

# Admin API key
ADMIN_API_KEY=your-emporium-admin-key

# Server port (use a different port than ReUp if running both locally)
PORT=8083
