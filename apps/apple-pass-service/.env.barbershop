# ─── Emporium Grooming & Supply — Apple Pass Configuration ──
# Copy this to .env and fill in your values.

# Your Apple Developer identifiers (must match your cert)
PASS_TYPE_IDENTIFIER=pass.com.emporiumgrooming.loyalty
TEAM_IDENTIFIER=YOUR_TEAM_ID

# Organization / branding
ORGANIZATION_NAME=Emporium Grooming & Supply
PASS_DESCRIPTION=Emporium Grooming Loyalty Card
LOGO_TEXT=Emporium Grooming

# Brand assets directory (icons & logos for the .pkpass bundle)
ASSETS_DIR=./assets-barbershop

# Pass signing certificates (paths to .pem files)
PASS_CERT=./secrets/emporium-pass-cert.pem
PASS_KEY=./secrets/emporium-pass-key.pem
WWDR_CERT=./secrets/wwdr.pem

# Your server's public HTTPS URL
WEB_SERVICE_URL=https://your-server.com/passes

# APNs push notifications (.p8 auth key from Apple Developer)
APNS_KEY_PATH=./secrets/apns-auth-key.p8
APNS_KEY_ID=YOUR_KEY_ID

# Admin API key
ADMIN_API_KEY=your-emporium-admin-key

# Server port (use a different port than ReUp if running both locally)
PORT=8082

# Default geofence — your shop location (JSON array)
# Update the lat/lng to your actual shop address.
DEFAULT_LOCATIONS=[{"latitude":40.7580,"longitude":-73.9855,"relevantText":"Welcome to Emporium Grooming & Supply! Show your pass for rewards."}]

# NODE_ENV=production
