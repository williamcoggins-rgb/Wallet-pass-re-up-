# ─── Barbershop Pass Configuration ──────────────────────────
# Copy this to .env and fill in your values.

# Your Apple Developer identifiers (must match your cert)
PASS_TYPE_IDENTIFIER=pass.com.yourbarbershop.loyalty
TEAM_IDENTIFIER=YOUR_TEAM_ID

# Organization / branding
ORGANIZATION_NAME=Your Barbershop
PASS_DESCRIPTION=Barbershop Loyalty Card
LOGO_TEXT=Your Barbershop

# Brand assets directory (icons & logos for the .pkpass bundle)
ASSETS_DIR=./assets-barbershop

# Pass signing certificates (paths to .pem files)
PASS_CERT=./secrets/barbershop-pass-cert.pem
PASS_KEY=./secrets/barbershop-pass-key.pem
WWDR_CERT=./secrets/wwdr.pem

# Your server's public HTTPS URL
WEB_SERVICE_URL=https://your-barbershop-server.com/passes

# APNs push notifications (.p8 auth key from Apple Developer)
APNS_KEY_PATH=./secrets/apns-auth-key.p8
APNS_KEY_ID=YOUR_KEY_ID

# Admin API key
ADMIN_API_KEY=your-barbershop-admin-key

# Server port (use a different port than ReUp if running both locally)
PORT=8082

# Default geofence — your shop location (JSON array)
DEFAULT_LOCATIONS=[{"latitude":40.7580,"longitude":-73.9855,"relevantText":"Welcome! Show your loyalty card for a discount."}]

# NODE_ENV=production
