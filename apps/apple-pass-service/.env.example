# ─── Apple Pass Service Configuration ───────────────────────

# Your Apple Developer identifiers
PASS_TYPE_IDENTIFIER=pass.com.reup.membership
TEAM_IDENTIFIER=YOUR_TEAM_ID

# Organization
ORGANIZATION_NAME=ReUp
PASS_DESCRIPTION=ReUp Pass

# Pass signing certificates (paths to .pem files)
PASS_CERT=./secrets/pass-cert.pem
PASS_KEY=./secrets/pass-key.pem
WWDR_CERT=./secrets/wwdr.pem

# Your server's public HTTPS URL (Apple requires HTTPS)
WEB_SERVICE_URL=https://your-server.com/passes

# APNs push notifications (.p8 auth key from Apple Developer)
APNS_KEY_PATH=./secrets/apns-auth-key.p8
APNS_KEY_ID=YOUR_KEY_ID

# Admin API key (protects /admin endpoints — set the same key in Vercel env vars)
ADMIN_API_KEY=your-secret-admin-key-here

# Server port
PORT=8080

# Set to "production" for live APNs, omit for sandbox
# NODE_ENV=production
